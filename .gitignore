# Local/dev-only — never commit real credentials or uploaded user content
config.local.php
assets/css/*.min.css
uploads/icons/*
uploads/screenshots/*
uploads/.cache/
uploads/.openrouter_models_cache.json
uploads/*.log
db-error.log
*.log
.DS_Store

!uploads/icons/.gitkeep
!uploads/screenshots/.gitkeep

# syria-home sub-app
syria-home/config.generated.php
syria-home/install/install.lock
syria-home/uploads/*
!syria-home/uploads/.gitkeep

# infinityfree-store sub-app — DB credentials & admin secret, written by
# the in-browser setup wizard, never committed
infinityfree-store/config.local.php

# yassota sub-app — DB credentials (setup wizard) + user uploads, never committed
yassota/config.local.php
yassota/uploads/*
!yassota/uploads/.gitkeep
!yassota/uploads/.htaccess
# Android signing secrets (APK build phase)
yassota/android/*.jks
yassota/android/*.keystore
yassota/android/keystore.properties
yassota/android/secrets.properties
