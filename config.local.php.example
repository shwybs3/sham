/* ═══════════════════════════════════════════════════════════════
   config.local.php  —  إعدادات بيئة التشغيل الفعلية
   ───────────────────────────────────────────────────────────────
   • هذا الملف لا يُرفع إلى git (مُضاف في .gitignore)
   • عند النشر الأول: انسخ هذا الملف باسم config.local.php
     cp config.local.php.example config.local.php
   • ثم عدّله ببياناتك الحقيقية
   • بعد ذلك: أي تحديث لـ config.php لن يؤثر على بياناتك هنا
   ═══════════════════════════════════════════════════════════════ */

// ── قاعدة البيانات ──────────────────────────────────────────────
define('DB_HOST', 'localhost');
define('DB_NAME', 'your_db_name');       // اسم قاعدة البيانات
define('DB_USER', 'your_db_user');       // اسم المستخدم
define('DB_PASS', 'your_db_password');   // كلمة المرور

// ── الموقع ──────────────────────────────────────────────────────
define('SITE_URL',   'https://your-domain.com');  // بدون / في النهاية
define('SITE_NAME',  'اسم موقعك');
define('APP_SECRET', 'ضع-هنا-سلسلة-عشوائية-طويلة-وآمنة');

// ── أمان ────────────────────────────────────────────────────────
// IP الخاص بك — مُعفى دائماً من كل فحوصات الأمان والإحصاءات
define('EVIL_ADMIN_IP', '0.0.0.0');   // ← ضع IP الإنترنت الخاص بك

