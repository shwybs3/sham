Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # فرض HTTPS — فعّله فقط بعد تأكيد أن شهادة SSL نشطة فعلياً على استضافتك
  # (AutoSSL/Let's Encrypt عادة تُفعَّل تلقائياً من لوحة تحكم الاستضافة خلال دقائق من ربط الدومين)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ملفات SEO بأسماء نظيفة
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^rss\.xml$ rss.php [L]

  # الصفحة الرئيسية: توجيه index.php القديم للجذر
  RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
  RewriteRule ^index\.php$ / [R=301,L,QSA]

  # روابط نظيفة للمنتج: /p/{slug} → product.php?slug={slug}
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^p/([^/]+)/?$ product.php?slug=$1 [L,QSA]

  # روابط نظيفة للدفع: /checkout/{slug} → checkout.php?slug={slug}
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^checkout/([^/]+)/?$ checkout.php?slug=$1 [L,QSA]

  # إخفاء admin.php خلف /admin
  RewriteRule ^admin/?$ admin.php [L,QSA]

  # صفحة تحميل المنتج
  RewriteRule ^download/?$ download.php [L,QSA]

  # صفحات ثابتة بدون امتداد .php
  RewriteRule ^about/?$ about.php [L]
  RewriteRule ^contact/?$ contact.php [L]
  RewriteRule ^privacy-policy/?$ privacy-policy.php [L]
  RewriteRule ^terms/?$ terms.php [L]
  RewriteRule ^refund-policy/?$ refund-policy.php [L]
  RewriteRule ^cookie-policy/?$ cookie-policy.php [L]

  # إعادة توجيه 301 من الروابط القديمة .php لنظيراتها النظيفة
  RewriteCond %{THE_REQUEST} \s/(about|contact|privacy-policy|terms|refund-policy|cookie-policy)\.php[\s?] [NC]
  RewriteRule ^(.+)\.php$ /$1 [R=301,L]
</IfModule>

# ── ضغط المحتوى ───────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff font/ttf
  DeflateCompressionLevel 6
</IfModule>

# ── تخزين مؤقت بالمتصفح ───────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 3 months"
  ExpiresByType application/javascript    "access plus 3 months"
  ExpiresByType image/svg+xml             "access plus 3 months"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
</IfModule>

# ── رؤوس أمان (تحسينات Red Team الأساسية) ─────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options  "nosniff"
  Header set X-Frame-Options         "SAMEORIGIN"
  Header set Referrer-Policy         "strict-origin-when-cross-origin"
  Header set X-XSS-Protection        "1; mode=block"
  Header set Permissions-Policy      "geolocation=(), camera=(), microphone=()"
  Header append Vary Accept-Encoding
  <FilesMatch "\.(css|js|woff2?|ttf|svg|png|jpg|jpeg|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

FileETag MTime Size

# ── منع الوصول المباشر لملفات حساسة ───────────
<FilesMatch "\.(sql|log|env|md)$">
  Require all denied
</FilesMatch>
<FilesMatch "config\.php$">
  Require all denied
</FilesMatch>

# -- block direct access to data/ (DB + cache files)
<IfModule mod_rewrite.c>
  RewriteRule ^data/ - [F,L]
</IfModule>
