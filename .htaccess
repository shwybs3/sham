Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS — required for AdSense and for the cookie-consent /
  # localStorage behavior to be trustworthy. IMPORTANT: only keep this
  # enabled once your hosting actually has a valid SSL certificate active
  # (most cPanel hosts auto-provision one via AutoSSL/Let's Encrypt) — if
  # SSL isn't active yet, this causes a redirect loop. Comment out the two
  # lines below if that happens, until SSL is confirmed working.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^robots\.txt$ robots.php [L]

  # Canonical homepage: redirect old /index.php links/bookmarks to the root
  # (matched against the original client request line so the internal
  # rewrite to index.php below never re-triggers this and loops).
  RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
  RewriteRule ^index\.php$ / [R=301,L,QSA]

  # Pretty URLs: /{app-slug}/download -> download.php?slug={app-slug}
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^/]+)/download/?$ download.php?slug=$1 [L,QSA]

  # Pretty URLs: /{app-slug} -> app.php?slug={app-slug}
  # (skipped automatically for any URL matching a real file/directory above,
  # e.g. /admin.php, /assets/..., /uploads/... — see RESERVED_SLUGS in
  # config.php for the matching guard against an app slug ever colliding
  # with a route name like /about or /contact)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^/]+)/?$ app.php?slug=$1 [L,QSA]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType text/css   "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "\.(sql|log|env|json)$">
  Require all denied
</FilesMatch>
<Files "manifest.json">
  Require all granted
</Files>

<FilesMatch "config\.php$">
  Require all denied
</FilesMatch>
